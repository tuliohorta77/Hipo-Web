# ============================================================
# HIPO — Variáveis de Ambiente
# Copiar para /home/hipo/app/.env e preencher os valores
# ============================================================

# Banco de dados PostgreSQL (RDS)
DATABASE_URL=postgresql://hipo_user:SENHA@SEU-RDS-ENDPOINT:5432/hipo

# Segurança JWT
JWT_SECRET=gere-uma-chave-longa-e-aleatoria-aqui
JWT_EXPIRE_HOURS=12

# Upload de arquivos
UPLOAD_DIR=/home/hipo/app/uploads
MAX_UPLOAD_MB=50

# Anexos de tarefa (print do WhatsApp, PDF). Vazio = recurso desligado.
# A credencial vem da role da instancia (hipo-ec2-ses), nao daqui.
S3_BUCKET_ANEXOS=hipo-anexos-520723705827

# Agenda: convite no Google Calendar. Vazio = recurso desligado (a reuniao
# e criada do mesmo jeito, so nao vira evento).
# Chave JSON da conta de servico, com dono `hipo` e modo 600. A delegacao
# em todo o dominio e configurada uma vez no Admin Console do Workspace --
# passo a passo no cabecalho de api/services/google_agenda.py.
GOOGLE_SA_ARQUIVO=/home/hipo/app/google-sa.json
GOOGLE_CALENDAR_FUSO=America/Sao_Paulo

# Ambiente
ENVIRONMENT=production
