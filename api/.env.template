# ============================================================
# HIPO — Variáveis de Ambiente
# Copiar para /home/hipo/app/.env e preencher os valores
# ============================================================

# Banco de dados PostgreSQL (RDS)
DATABASE_URL=postgresql://hipo_user:SENHA@SEU-RDS-ENDPOINT:5432/hipo

# Segurança JWT
JWT_SECRET=gere-uma-chave-longa-e-aleatoria-aqui
JWT_EXPIRE_HOURS=12

# Upload de arquivos
UPLOAD_DIR=/home/hipo/app/uploads
MAX_UPLOAD_MB=50

# Anexos de tarefa (print do WhatsApp, PDF). Vazio = recurso desligado.
# A credencial vem da role da instancia (hipo-ec2-ses), nao daqui.
S3_BUCKET_ANEXOS=hipo-anexos-520723705827

# Agenda: convite no Google Calendar. Vazio = recurso desligado (a reuniao
# e criada do mesmo jeito, so nao vira evento).
# Chave JSON da conta de servico, com dono `hipo` e modo 600. A delegacao
# em todo o dominio e configurada uma vez no Admin Console do Workspace --
# passo a passo no cabecalho de api/services/google_agenda.py.
GOOGLE_SA_ARQUIVO=/home/hipo/app/google-sa.json
GOOGLE_CALENDAR_FUSO=America/Sao_Paulo

# Enriquecimento cadastral por CNPJ (migration 014).
# Lista separada por virgula, NA ORDEM DE PRECEDENCIA: a primeira fonte
# que trouxer um campo vence, as seguintes so completam o que faltou.
# Vazio = recurso desligado, e a tela nem oferece o botao de buscar.
ENRIQUECIMENTO_FONTES=brasilapi,econodata
# Dias que uma consulta bem-sucedida vale antes de ir de novo a fonte.
# Em fonte paga isto e dinheiro. 0 desliga o cache.
ENRIQUECIMENTO_TTL_DIAS=90
#
# A ORDEM IMPORTA. A BrasilAPI vem primeiro porque cobre todo o cadastro de
# graca, da mesma base da Receita; a fonte paga vem depois so para completar
# o que faltou. Invertida, a paga venceria em campos que nao precisava.
#
# Econodata: entrou por UM dado -- quadro de pessoal. Nenhuma fonte publica
# tem esse numero (a Receita nao publica, e `porte` e faixa de FATURAMENTO).
# O normalizador dela devolve SO `num_funcionarios`, de proposito: ler os
# outros campos seria pagar por dado que a BrasilAPI ja deu, e criaria
# divergencia entre duas fontes dizendo a mesma coisa com grafia diferente.
ECONODATA_API_KEY=
# Os tres abaixo ja vem certos no codigo. Descomente so se a API mudar.
#   ECONODATA_URL=https://api.econodata.com.br/v4
#   ECONODATA_CAMINHO=companies/search
# Blocos deles: cadastro, estrategico, perfilNegocio, contatosBasicos,
# contatosAvancados. A cobranca e por tipo de informacao pedida, entao
# pedimos so o que carrega funcionarios.
#   ECONODATA_BLOCOS=estrategico

# LeadCNPJ. Sem a chave, so a BrasilAPI responde: some o numero de
# funcionarios estimado e continua todo o resto.
LEADCNPJ_API_KEY=
# Os quatro abaixo ja vem certos no codigo, conforme a pagina publica
# leadcnpj.com.br/api-empresas. So descomente se a API deles mudar --
# ajuste de .env + restart, sem deploy.
#   LEADCNPJ_URL=https://leadcnpj.com.br/api
#   LEADCNPJ_HEADER=Authorization
#   LEADCNPJ_PREFIXO_HEADER=Bearer
#   LEADCNPJ_CAMINHO_CNPJ=v1/empresa/{cnpj}?enriquecer=true
#
# `enriquecer=true` e o que traz o numero de funcionarios. Sem ele a
# resposta e so o espelho da Receita, que a BrasilAPI da de graca.
#
# Busca reversa de socio: a LeadCNPJ NAO tem esse endpoint. A API deles
# consulta por CNPJ, busca por filtros firmograficos e enriquece em lote
# -- nenhuma responde "em que outras empresas este CPF aparece". Deixe
# vazio: a tela mostra so as empresas que ja estao no HIPO, dizendo isso.
#   LEADCNPJ_CAMINHO_SOCIO=

# Ambiente
ENVIRONMENT=production

# -- CORS ---------------------------------------------------------------
# Vazio e o normal. Em producao vira https://hipogestao.com.br (+ www);
# fora de producao vira "*". O front fala com a API pela mesma origem,
# entao so preencha se um cliente de OUTRA origem precisar chamar a API.
# Em producao "*" e ignorado.
#   CORS_ORIGINS=https://hipogestao.com.br,https://www.hipogestao.com.br

# -- Pool asyncpg -------------------------------------------------------
# Por worker do uvicorn (sao 4): teto real = 4 x DB_POOL_MAX conexoes.
# Os padroes do codigo valem; descomente so para ajustar.
#   DB_POOL_MIN=1
#   DB_POOL_MAX=5
# Teto por comando em segundos; 0 = sem teto (comportamento anterior).
#   DB_COMMAND_TIMEOUT_S=0

# -- Observabilidade: Sentry (032) --------------------------------------
# Vazio = desligado. DSN do projeto no Sentry (Settings > Projects >
# hipo-api > Client Keys). A MOS pode usar o mesmo DSN: o ambiente sai
# "production-mos" sozinho, pela EMPRESA_SIGLA.
# ORDEM: so preencha DEPOIS do deploy que trouxe o campo (extra="forbid").
SENTRY_DSN=
#   SENTRY_AMBIENTE=production
#   SENTRY_TRACES_SAMPLE_RATE=0

# -- Limite de tentativas de login (032) --------------------------------
# Os padroes do codigo valem; descomente so para ajustar.
#   LOGIN_LIMITE_ATIVO=true
#   LOGIN_JANELA_MIN=15
#   LOGIN_MAX_FALHAS_EMAIL=5
#   LOGIN_MAX_FALHAS_IP=20
#   LOGIN_RETENCAO_DIAS=180

# -- Roleplay com IA (Carreira, 034) ------------------------------------
# Chave do Gemini (AI Studio, plano pre-pago). Vazio = roleplay desligado.
# Conferir depois de configurar: python -m scripts.roleplay_diagnostico
GEMINI_API_KEY=
ROLEPLAY_MODELO_VOZ=gemini-3.8-live
ROLEPLAY_ORCAMENTO_MES_USD=30
ROLEPLAY_LIMITE_DIA=2
ROLEPLAY_DURACAO_MAX_MIN=55
