[Unit]
# HIPO -- sincroniza os contratos com a Autentique (053).
#
# Instalacao: infra/instalar-timer-contratos.sh (o deploy-053 roda).
# O rsync do CI NAO leva a pasta infra/: a unit vai por scp.
#
# Verificacao:
#   systemctl list-timers hipo-contratos.timer
#   sudo systemctl start hipo-contratos.service   # roda agora
#   journalctl -u hipo-contratos.service -n 50 --no-pager
Description=HIPO -- sincroniza os contratos com a Autentique
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ec2-user, o mesmo usuario de hipo-api.service e de hipo-emails.
# Com `hipo`, o pydantic-settings nao le o .env (600 ec2-user).
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/hipo/app/api
EnvironmentFile=/home/hipo/app/.env
Environment=PYTHONPATH=/home/hipo/app/api
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 -m scripts.sincronizar_contratos

# Sem Restart=: o proprio timer e a retentativa, e o script e idempotente.
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
