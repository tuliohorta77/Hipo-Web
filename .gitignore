# ==========================================================
# HIPO - .gitignore
# Revisado em 2026-09-22. Consolidado: regras duplicadas e
# padroes de backup redundantes foram unificados.
# ==========================================================

# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
.venv/
venv/
env/
.env
*.env

# Node
node_modules/
dist/
build/
*.local

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testes e cobertura
.pytest_cache/
.coverage
htmlcov/
coverage/

# Uploads e logs
uploads/
*.log
logs/

# ----------------------------------------------------------
# Backups e patches locais gerados por script (nunca commitar)
# Cobre _backup-*, _backup_*, backup_hotfix_*, _backup_carteira_*,
# _backup_patch_*, _backup-014-* e todo .bak / .bak2_ / .bakP* / .bakV*
# ----------------------------------------------------------
_backup-*/
_backup_*/
backup_*/
backups/
_patches/
*.bak*
*.patch
*.zip

# Pastas extraidas dos zips de install (ficam temporariamente na raiz)
clientes/
schema-fix/
schema-fix-2/
acessos/
acessos-hotfix/
tema-novo/
carteira-v*/

# Scripts descartaveis soltos na raiz
install-*.ps1
apply-*.ps1
patch-*.ps1

# ----------------------------------------------------------
# Dados reais de empresas e contatos
# O remoto e github.com/tuliohorta77/Hipo-Web -- nada de base
# de cliente aqui. Arquivo JA rastreado ignora esta secao:
# precisa de "git rm --cached" para sair.
# ----------------------------------------------------------
_carga-*.sql
_carga-*.csv
_carga-*.xlsx
api/scripts/dados/*.csv
api/scripts/dados/*.json

# Entregas do Claude e anotacoes de trabalho (nao sao codigo)
Claude outputs/
mensagem-do-commit.txt

# ----------------------------------------------------------
# VERSIONADOS DE PROPOSITO -- nao ignorar:
#   ops/releases/     deploy-*.ps1, aplicar-*.ps1, fix-*.ps1
#                     (registro de como cada release subiu)
#   ops/utilitarios/  setup-*.ps1, diagnostico-*.ps1, liberar-*.ps1
#   scripts/          cargas e rotinas remotas (.ps1 / .sh / .py)
#
# ATENCAO: nao reintroduzir a linha "scripts/" aqui. Ela existia
# e, como git ignora por diretorio em qualquer nivel, deixava
# arquivos NOVOS em scripts/ e api/scripts/ invisiveis ao
# "git status" -- os 18 que estao lá hoje sobreviveram porque
# foram adicionados antes ou com "git add -f".
# ----------------------------------------------------------
