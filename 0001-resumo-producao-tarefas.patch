+    # `ate + 1 dia` à meia-noite: o fim exclusivo do último dia pedido.
+    fim = (
+        datetime.combine(ate + timedelta(days=1), time.min, tzinfo=fuso)
+        .astimezone(timezone.utc)
+        if ate is not None else None
+    )
+    return inicio, fim
