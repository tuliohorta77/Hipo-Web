+async def nova_oportunidade(client, headers, conta_id, **extra):
+    corpo = {"conta_id": conta_id}
+    corpo.update(extra)
+    resp = await client.post("/crm/oportunidades", json=corpo, headers=headers)
+    assert resp.status_code == 201, resp.text
